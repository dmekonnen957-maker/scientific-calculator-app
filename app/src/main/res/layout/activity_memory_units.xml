<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/memoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/memoryBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/primary_blue"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/memory_description"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Worked Examples Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/memory_worked_examples"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/workedExampleSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:padding="@dimen/spacing_small" />

        <!-- Input Quantity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/memory_input_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/memoryQuantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:hint="e.g. 1 or 16 or 1000"
            android:inputType="numberDecimal"
            android:minHeight="50dp"
            android:padding="@dimen/spacing_medium"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:typeface="monospace" />

        <!-- Source and Target Units -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_source_unit"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/sourceUnitSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:background="@drawable/bg_tool_card"
                    android:padding="@dimen/spacing_small" />
            </LinearLayout>

            <Button
                android:id="@+id/swapUnitsButton"
                android:layout_width="48dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginEnd="@dimen/spacing_small"
                android:backgroundTint="@color/secondary_button"
                android:text="⇄"
                android:textColor="@color/primary_blue"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_target_unit"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/targetUnitSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:background="@drawable/bg_tool_card"
                    android:padding="@dimen/spacing_small" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal">

            <Button
                android:id="@+id/convertMemoryButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:backgroundTint="@color/primary_blue"
                android:text="@string/memory_convert"
                android:textColor="@color/button_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/clearMemoryButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:backgroundTint="@color/secondary_button"
                android:text="@string/btn_clear"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Error View -->
        <TextView
            android:id="@+id/memoryError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_tool_card"
            android:padding="@dimen/spacing_small"
            android:textColor="@color/error_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Result Card -->
        <LinearLayout
            android:id="@+id/memoryResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_result_label"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/memoryResultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:text="@string/result_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/memoryExactBytesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:lineSpacingExtra="2dp"
                android:text="Exact bytes: —"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/saveMemoryButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/spacing_small"
                android:backgroundTint="@color/secondary_button"
                android:text="@string/gate_save_result"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Decimal vs Binary Distinction Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/memory_distinction_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/memoryDistinctionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:lineSpacingExtra="3dp"
            android:padding="@dimen/spacing_medium"
            android:text="Distinction between decimal (1000) and binary (1024) units will appear here."
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <!-- Worked Conversion Steps -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/memory_steps_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/memoryStepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/memoryStepsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Worked step-by-step conversion will appear here."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- All Units Equivalent Table -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/memory_equivalents_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/memoryEquivalentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/memoryEquivalentsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equivalent values across bits, bytes, SI, and IEC units will appear here."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
