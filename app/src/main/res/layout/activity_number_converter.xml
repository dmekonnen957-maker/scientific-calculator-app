<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/converterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/converterBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/primary_blue"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/converter_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/converter_description"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/sample_values"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sampleBinary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/sample_binary"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/sampleOctal"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/spacing_xsmall"
                    android:text="@string/sample_octal"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/sampleDecimal"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/spacing_xsmall"
                    android:text="@string/sample_decimal"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/sampleHexadecimal"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/spacing_xsmall"
                    android:text="@string/sample_hexadecimal"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/numberInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:hint="@string/hint_input"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:backgroundTint="@color/primary_blue" />

        <Spinner
            android:id="@+id/baseSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:contentDescription="@string/select_base" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal">

            <Button
                android:id="@+id/convertButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="@string/btn_convert"
                android:textColor="@color/button_text" />

            <Button
                android:id="@+id/clearButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:backgroundTint="@color/secondary_button"
                android:text="@string/btn_clear"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/conversion_results"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/use_result_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <include
                layout="@layout/item_conversion_result"
                android:id="@+id/resultRowBinary"
                android:tag="binary" />
            <include
                layout="@layout/item_conversion_result"
                android:id="@+id/resultRowOctal"
                android:tag="octal" />
            <include
                layout="@layout/item_conversion_result"
                android:id="@+id/resultRowDecimal"
                android:tag="decimal" />
            <include
                layout="@layout/item_conversion_result"
                android:id="@+id/resultRowHexadecimal"
                android:tag="hexadecimal" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/conversion_steps"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/conversionExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_tool_card"
            android:padding="@dimen/spacing_medium"
            android:text="@string/explanation_prompt"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
