<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:background="@drawable/bg_tool_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <!-- Top Row: Module Badge, Timestamp, Delete Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/recordModuleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon_tile"
            android:paddingStart="@dimen/spacing_small"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="2dp"
            android:text="Binary Arithmetic"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recordTimestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="Just now"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/recordDeleteButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Delete record"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/error_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Operation & Configuration -->
    <TextView
        android:id="@+id/recordOperationConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xsmall"
        android:text="Addition (+) · 8-bit"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Input Expression -->
    <TextView
        android:id="@+id/recordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="1011 + 0111"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <!-- Result -->
    <TextView
        android:id="@+id/recordResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="= 10010 (DEC: 18)"
        android:textColor="@color/primary_blue"
        android:textSize="14sp"
        android:typeface="monospace" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/recordDetailsButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/secondary_button"
            android:text="Details"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/recordReuseButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/spacing_small"
            android:backgroundTint="@color/primary_blue"
            android:text="↶ Reuse Input"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
