<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/historyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding"
    android:paddingTop="@dimen/spacing_small"
    android:paddingEnd="@dimen/page_padding">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/historyBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/primary_blue"
            android:textSize="36sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/history_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historyClear"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small"
            android:text="@string/clear_history"
            android:textColor="@color/error_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/history_description"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Search Input -->
    <EditText
        android:id="@+id/historySearchInput"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_tool_card"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="@dimen/spacing_small"
        android:hint="Search input, result, or operation..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- Module Filter Spinner -->
    <Spinner
        android:id="@+id/historyModuleFilter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:background="@drawable/bg_tool_card"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium" />

    <!-- Record Count Header -->
    <TextView
        android:id="@+id/historyCountLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="Showing all calculations (newest first)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Empty State Message -->
    <TextView
        android:id="@+id/historyEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tool_card"
        android:padding="@dimen/spacing_large"
        android:text="@string/history_empty"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- History Records List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_large" />
    </ScrollView>
</LinearLayout>
