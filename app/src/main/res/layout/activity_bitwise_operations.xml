<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bitwiseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bitwiseBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/primary_blue"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bitwise_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/bitwise_description"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Bit Width Selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/bitwise_width_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/bitWidthSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:padding="@dimen/spacing_small" />

        <!-- Operation Selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/bitwise_op_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/bitwiseOpSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:padding="@dimen/spacing_small" />

        <!-- Quick Samples -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/sample_values"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sampleAnd"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/secondary_button"
                    android:text="@string/bitwise_sample_and"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/sampleXor"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:backgroundTint="@color/secondary_button"
                    android:text="@string/bitwise_sample_xor"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/sampleNot"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:backgroundTint="@color/secondary_button"
                    android:text="@string/bitwise_sample_not"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/sampleShl"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:backgroundTint="@color/secondary_button"
                    android:text="@string/bitwise_sample_shl"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/sampleSar"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:backgroundTint="@color/secondary_button"
                    android:text="@string/bitwise_sample_sar"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Operand A -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/bitwise_operand_a"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/bitwiseOperandA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:hint="@string/bitwise_input_hint"
            android:inputType="textVisiblePassword"
            android:minHeight="50dp"
            android:padding="@dimen/spacing_medium"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/operandAPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="BIN: —  |  HEX: —"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Operand B -->
        <TextView
            android:id="@+id/operandBLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/bitwise_operand_b"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/bitwiseOperandB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:hint="@string/bitwise_input_hint"
            android:inputType="textVisiblePassword"
            android:minHeight="50dp"
            android:padding="@dimen/spacing_medium"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/operandBPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="BIN: —  |  HEX: —"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal">

            <Button
                android:id="@+id/calculateBitwiseButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:backgroundTint="@color/primary_blue"
                android:text="@string/calculator_equals"
                android:textColor="@color/button_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/clearBitwiseButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:backgroundTint="@color/secondary_button"
                android:text="@string/btn_clear"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Error View -->
        <TextView
            android:id="@+id/bitwiseError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_tool_card"
            android:padding="@dimen/spacing_small"
            android:textColor="@color/error_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Result Card -->
        <LinearLayout
            android:id="@+id/bitwiseResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bitwise_result_label"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bitwiseBinaryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:text="@string/result_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/bitwiseHexResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:text="HEX: —"
                android:textColor="@color/primary_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/bitwiseDecimalResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:text="Unsigned: —  |  Signed: —"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/saveBitwiseButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/spacing_small"
                android:backgroundTint="@color/secondary_button"
                android:text="@string/gate_save_result"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bit-by-Bit Comparison -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/bitwise_comparison_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bitwiseBitGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:lineSpacingExtra="3dp"
            android:padding="@dimen/spacing_medium"
            android:text="Bit alignment comparison will appear here."
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:typeface="monospace" />

        <!-- Fixed-Width Masking Explanation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/bitwise_masking_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bitwiseMaskingExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:lineSpacingExtra="2dp"
            android:padding="@dimen/spacing_medium"
            android:text="Masking explanation will appear here."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Signedness Explanation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/bitwise_signedness_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bitwiseSignednessExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:lineSpacingExtra="2dp"
            android:padding="@dimen/spacing_medium"
            android:text="Signedness interpretation will appear here."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Shift Behavior Explanation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/bitwise_shift_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bitwiseShiftExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:background="@drawable/bg_tool_card"
            android:lineSpacingExtra="2dp"
            android:padding="@dimen/spacing_medium"
            android:text="Shift and operator explanations will appear here."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
