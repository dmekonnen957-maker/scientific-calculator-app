    <string name="flags_register_title">Status register</string>
    <string name="flags_register_prompt">Calculate an operation to view flag bit positions.</string>
    <string name="flags_register_layout">Bit:  %1$s\nName: %2$s\nValue:%3$s</string>
    <string name="flags_register_item">%1$s\n%2$s</string>
    <string name="flags_set">SET</string>
    <string name="flags_clear">CLEAR</string>
    <string name="flags_undefined">UNDEFINED</string>
    <string name="flags_explanation_prompt">Choose a processor and operation, enter operands, and calculate to see the flag rules applied.</string>
    <string name="flags_add_explanation">ADD sets carry when the unsigned sum exceeds the selected width; auxiliary carry records carry out of bit 3.</string>
    <string name="flags_sub_explanation">SUB/CMP sets carry on unsigned borrow; auxiliary carry records borrow from bit 4. CMP updates flags without storing a result.</string>
    <string name="flags_logic_explanation">Logical operations update result-dependent sign, zero, and parity flags; architecture-specific carry and auxiliary rules are applied.</string>
    <string name="flags_calculation_explanation">Operands: %1$s %2$s %3$s. Masked %4$d-bit result: %5$s.\n%6$s Unsigned carry/borrow is %7$s and is distinct from signed overflow.</string>
    <string name="flags_compare_note">CMP performs subtraction for flags only; the computed difference is not written back to a register.</string>
    <string name="flags_af_undefined_note">The 8086 leaves AF undefined for logical instructions; it is not reported as set or cleared.</string>
    <string name="flags_overflow_explanation">For the 8086, OF indicates signed integer overflow while %1$s indicates unsigned carry or borrow. At 8 bits, 127 + 1 sets OF but not CF.</string>
    <string name="flags_8085_overflow_explanation">The 8085 exposes CY for unsigned carry/borrow and has no signed-overflow status flag.</string>
    <string name="flags_control_note">These are status flags. Control flags such as TF, IF, and DF on the 8086 are not calculated or modified by these operations.</string>
